import os
import shutil
import sys
import argparse
from Bio import SeqIO
from bofasa import util
import subprocess
import multiprocessing
import shutil
from rich_argparse import RawTextRichHelpFormatter
from collections import defaultdict

def create_parser():
	""" Parse arguments """
	parser = argparse.ArgumentParser(description="""

	██████╗  ██████╗ ███████╗ █████╗ ███████╗ █████╗ 
	██╔══██╗██╔═══██╗██╔════╝██╔══██╗██╔════╝██╔══██╗
	██████╔╝██║   ██║█████╗  ███████║███████╗███████║
	██╔══██╗██║   ██║██╔══╝  ██╔══██║╚════██║██╔══██║
	██████╔╝╚██████╔╝██║     ██║  ██║███████║██║  ██║
	╚═════╝  ╚═════╝ ╚═╝     ╚═╝  ╚═╝╚══════╝╚═╝  ╚═╝
                                                
	Program: bofasa_prep
	Authors: Rauf Salamzade, Aamuktha Kottapalli, Lindsay R. Kalan 
	Affiliation: University of Wisconsin - Madsion, McMaster University							  

	Prepares input genomes or annotation directories for bofasa 
	analysis.
								  
	It can take in contig/scaffold FASTA files (*.fasta, *.fa, *.fna), 
	GenBank files (*.genbank, *.gbk, *.gbff), with CDS features and 
	translation qualifiers available, or Prokka/Bakta annotation 
	folders. Note, gzipped files are not supported.
	
	Pfam HMMs will be used to split proteins into domain/inter-domain 
	units which will serve as the basis for orthologroup inference 
	downstream.
								  
	Annotations for transposases and MGEs will also be performed using 
	sequences from the ISFinder database and geNomad.
								  
	If Bakta or Prokka annotations are provided, please make sure 
	such annotations were run using the "--prefix" argument as this 
	will be important for parsing out sample names.
	""", formatter_class=RawTextRichHelpFormatter)
	parser.add_argument('-i', '--input-genomes', nargs='+', help='Path to directories or files with/corresponding to genomes (either in GenBank xor FASTA format).', required=False, default=[])
	parser.add_argument('-ib', '--input-bakta', help='Path to a directory which contains Bakta annotation directories for input genomes.', required=False, default=None)
	parser.add_argument('-ip', '--input-prokka', help='Path to a directory which contains Prokka annotation directories for input genomes.', required=False, default=None)
	parser.add_argument('-o', '--output-dir', help='Resulting directory which will serve as the input for bofasa.', required=True)
	parser.add_argument('-ml', '--min-length', type=int, help="Minimum length of domain/inter-domain unit to consider [Default is 20].", required=False, default=20)
	parser.add_argument('-gcm', '--gene-calling-method', help='Method to use for gene calling. Options are: pyrodigal or prodigal [Default is pyrodigal].', required=False, default='pyrodigal')
	parser.add_argument('-dm', '--draft-mode', action='store_true', help="For when genomes are highly fragmented. Will use p(y)rodigal meta-mode for gene-calling to also identify genes that are truncated and on scaffold edges.", required=False, default=False)
	parser.add_argument('-rg', '--run-genomad', action='store_true', help="Whether to run geNomad - takes time but results can be used to achieve higher quality orthogroup predictions.", required=False, default=False)
	parser.add_argument('-r', '--rename-locus-tags', action='store_true', help="Whether to rename locus tags if provided for CDS features.", required=False, default=False)
	parser.add_argument('-x', '--ignore-upperbound-limit', action='store_true', help="Ignore the upper bound limit for the number of genomes to process [Default is 200].", required=False, default=False)
	parser.add_argument('-c', '--threads', type=int, help="Total number of cores/threads to use for running OrthoFinder2/prodigal.\n[Default is 1].", required=False, default=1)
	parser.add_argument('-mm', '--max-memory', type=int, help='Uses resource module to set soft memory limit. Provide in Giga-bytes [Default is None].', default=None, required=False)
	parser.add_argument('-v', '--version', action='store_true', help="Get version and exit.", required=False, default=False)

	args = parser.parse_args()
	return args


# GLOBAL VARIABLES
valid_fasta_suffices = set(['fasta', 'fna', 'fa'])
valid_genbank_suffices = set(['genbank', 'gbff', 'gbk'])

def prepare_input():
	"""
	Void function which runs primary workflow for program.
	"""

	# get version
	version = util.getVersion()

	if len(sys.argv)>1 and ('-v' in set(sys.argv) or '--version' in set(sys.argv)):
		sys.stdout.write(version + '\n')
		sys.exit(0)

	"""
	PARSE ARGUMENTS
	"""
	myargs = create_parser()

	input_genomes = myargs.input_genomes
	input_bakta_dir = myargs.input_bakta
	input_prokka_dir = myargs.input_prokka
	outdir = os.path.abspath(myargs.output_dir) + '/'
	
	run_genomad = myargs.run_genomad
	min_length = myargs.min_length
	rename_locus_tags = myargs.rename_locus_tags
	gene_calling_method = myargs.gene_calling_method
	meta_mode = myargs.draft_mode
	ignore_upperbound_limit_flag = myargs.ignore_upperbound_limit
	threads = myargs.threads
	max_memory = myargs.max_memory

	if os.path.isdir(outdir):
		sys.stderr.write("Output directory exists! Exiting\n ")
		sys.exit(1)
	else:
		os.system('mkdir %s' % outdir)


	valid_input_types = 0
	input_type = []
	input_genome_files = None
	if len(input_genomes) > 0: 
		try:
			input_genome_files = []
			for inp in input_genomes:
				if os.path.isfile(inp) and (inp.split('.')[-1] in valid_fasta_suffices or inp.split('.')[-1] in valid_genbank_suffices): 
					input_genome_files.append(os.path.abspath(inp))
				elif os.path.isdir(inp):
					inp_dir = os.path.abspath(inp) + '/'
					for f in os.listdir(inp_dir):
						if f.split('.')[-1] in valid_fasta_suffices or f.split('.')[-1] in valid_genbank_suffices:
							input_genome_files.append(inp_dir + f)
			try:
				assert(len(input_genome_files) >= 4)
			except:
				sys.stderr.write('At least four files with valid suffices are needed for bofasa analysis, exiting ...\n')
				sys.exit(1)
			input_type.append('genomes')
			valid_input_types += 1
		except:
			sys.stderr.write('Issue with finding valid input genomes in directories / files provided to the --input-genomes argument.\n')
			sys.exit(1)
	
	if input_prokka_dir != None:
		try:
			assert(os.path.isdir(input_prokka_dir))
			input_prokka_dir = os.path.abspath(input_prokka_dir) + '/'
			input_type.append('Prokka directories')
			valid_input_types += 1
		except:
			sys.stderr.write('Issue with validating path provided for the --input-prokka argument is a valid directory.\n')
			sys.exit(1)

	
	if input_bakta_dir != None:
		try:
			assert(os.path.isdir(input_bakta_dir))
			input_prokka_dir = os.path.abspath(input_bakta_dir) + '/'
			input_type.append('Bakta directories')
			valid_input_types += 1
		except:
			sys.stderr.write('Issue with validating path provided for the --input-bakta argument is a valid directory.\n')
			sys.exit(1)

	msg = 'No valid genome/prokka/bakta input found, exiting ...'
	if valid_input_types == 1:
		msg = 'Input provided as %s, continuing ...' % input_type[0]
	elif valid_input_types > 1:
		msg = 'Multiple valid input types provided, please only provide an argument for --input-genomes, --input-prokka, xor --input-bakta, exiting ...'
	if valid_input_types == 0 or valid_input_types > 1:
		sys.stderr.write(msg + '\n')
		sys.exit(1)
	else:
		sys.stdout.write(msg + '\n')
	
	"""
	START WORKFLOW
	"""

	# create logging object
	log_file = outdir + 'Progress.log'
	logObject = util.createLoggerObject(log_file)
	logObject.info("Saving parameters for future records.")
	parameters_file = outdir + 'Parameter_Inputs.txt'
	parameter_values = [input_genome_files, input_prokka_dir, input_bakta_dir, outdir, 
					    rename_locus_tags, meta_mode, run_genomad, ignore_upperbound_limit_flag,
					    gene_calling_method, min_length, threads, max_memory]
	parameter_names = ["Input Genomes Files", "Input Prokka Directory", "Input Bakta Directory", 
					   "Output Directory", "Rename Locus Tags?", "Draft Mode?",
					   "Run geNomad?", "Ignore Upperbound Genome Limit?", 
					   "Gene Calling Method", "Minimum Length of Domain/Inter-Domain Unit", 
					   "Number of Threads", 
					   "Maximum Memory in GB"]
	util.logParametersToFile(parameters_file, parameter_names, parameter_values)
	logObject.info("Done saving parameters!")

	sys.stdout.write('Input command:\n%s\n' % ' '.join(sys.argv))
	logObject.info('Input command:\n%s' % ' '.join(sys.argv))

	logObject.info('Running prepare_input version %s' % version)
	sys.stdout.write('Running prepare_input version %s\n' % version)

	# set max memory limit
	if max_memory != None:
		logObject.info("Setting maximum memory usage to: %dGB" % max_memory)
		try:
			util.memory_limit(max_memory)
		except Exception as e:
			logObject.info("Error setting memory limit")
			sys.stdout.write("Error setting memory limit\n")

	# Step 1: Process genomes
	msg = '--------------------\nStep 1\n--------------------\nProcessing genomes / annotation folders provided as input.'
	sys.stdout.write(msg + '\n')
	logObject.info(msg)
	
	gp_dir = outdir + 'Genome_Processing/'
	faa_dir = gp_dir + 'Proteomes/'
	bed_dir = gp_dir + 'BEDs/'

	util.setupReadyDirectory([gp_dir, faa_dir, bed_dir])

	input_type = input_type[0]
	sample_wgs = {}
	sample_proteomes = {}
	sample_beds = {}
	if input_type == 'genomes':
		formats = set([])
		sample_genomes = {}
		for inf in input_genome_files:
			suffix = inf.split('.')[-1]
			sample = '.'.join(inf.split('.')[:-1]).split('/')[-1]
			if suffix in valid_fasta_suffices:
				if util.is_fasta(inf):
					sample_genomes[sample] = inf
					sample_wgs[sample] = inf
				else:
					sys.stderr.write('Unable to verify %s as being in FASTA format.\n' % inf)
				formats.add('fasta')
			elif suffix in valid_genbank_suffices:
				if util.is_genbank(inf):
					sample_genomes[sample] = inf
				else:
					sys.stderr.write('Unable to verify %s as being in GenBank format.\n' % inf)
				formats.add('genbank')

		try:
			assert(len(formats) == 1)
		except:
			msg = 'Multiple types of genomic format detected and not supported. Exiting ...'
			logObject.error(msg)
			sys.stderr.write(msg + '\n')
			sys.exit(1)

		try:
			assert(len(sample_genomes[sample]) >= 4 and (len(sample_genomes[sample]) <= 200 or ignore_upperbound_limit_flag))
		except:
			msg = 'Too little or too many genomes provided, exiting ...'
			logObject.error(msg)
			sys.stderr.write(msg + '.\n')
			sys.exit(1)

		format = list(formats)[0]		
		if format == 'fasta':
			util.processGenomesUsingProdigal(sample_genomes, gp_dir, logObject,
										threads=threads, locus_tag_length=3, gene_calling_method=gene_calling_method,
										meta_mode=meta_mode)
			for sample in sample_genomes:
				faa = gp_dir + sample + '.faa'
				bed = gp_dir + sample + '.coords.bed'
				try:
					assert(os.path.isfile(faa) and os.path.isfile(bed))				
					renamed_faa = faa_dir + sample + '.faa'
					renamed_bed = bed_dir + sample + '.bed'
					shutil.move(faa, renamed_faa)
					shutil.move(bed, renamed_bed)
					sample_proteomes[sample] = renamed_faa
					sample_beds[sample] = renamed_bed
				except:
					msg = 'Unable to validate proper processing for sample %s, skipping it' % sample
					logObject.info(msg)
					sys.stderr.write(msg + '\n')
					if sample in sample_wgs:
						del sample_wgs[sample]
		else:
			util.processGenomesAsGenbanks(sample_genomes, gp_dir, logObject,
									threads=threads, locus_tag_length=3, rename_locus_tags=rename_locus_tags)
			for sample in sample_genomes:
				faa = gp_dir + sample + '.faa'
				bed = gp_dir + sample + '.coords.bed'
				fna = gp_dir + sample + '.fna'
				try:
					assert(os.path.isfile(faa) and os.path.isfile(bed) and os.path.isfile(fna))
					assert(os.path.getsize(faa) > 0 and os.path.getsize(bed) > 0 and os.path.getsize(fna) > 0)
					renamed_faa = faa_dir + sample + '.faa'
					renamed_bed = bed_dir + sample + '.bed'
					shutil.move(faa, renamed_faa)
					shutil.move(bed, renamed_bed)
					sample_proteomes[sample] = renamed_faa
					sample_beds[sample] = renamed_bed
					sample_wgs[sample] = fna
				except:
					msg = 'Unable to validate proper processing for sample %s, skipping it' % sample
					logObject.info(msg)
					sys.stderr.write(msg + '\n')
					if sample in sample_wgs:
						del sample_wgs[sample]

		msg = 'Found and successfully processed %d genomes in %s format, continuing ...' % (len(sample_genomes), format)
		logObject.info(msg)
		sys.stdout.write(msg + '\n')

	elif input_type == 'Prokka directories':
		scaffold_lengths = defaultdict(dict)
		for subdir, dirs, files in os.walk(input_prokka_dir):
			for file in files:
				filepath = subdir + '/' + file
				if filepath.endswith('.fna'):
					sample = '.fna'.join(file.split('/')[-1].split('.fna')[:-1])
					sample_wgs[sample] = filepath
					with open(filepath) as ogf:
						for rec in SeqIO.parse(ogf, 'fasta'):
							scaffold = rec.id
							scaffold_lengths[sample][scaffold] = len(str(rec.seq))

		possible_locustags = util.createLocusTagOptions(3)
		gff_iter = 0 	
		sample_old_to_new_lts = defaultdict(dict)
		prot_id_counts = defaultdict(int)
		for subdir, dirs, files in os.walk(input_prokka_dir):
			for file in files:
				filepath = subdir + '/' + file
				if filepath.endswith(".gff"):
					lt_str = possible_locustags[gff_iter]
					sample = '.gff'.join(file.split('/')[-1].split('.gff')[:-1])
					bed_file = bed_dir + sample + '.bed'
					bed_outfile_handle = open(bed_file, 'w')
					ci = 1
					with open(filepath) as ofp:
						for line in ofp:
							line = line.strip()
							ls = line.split('\t')

							if line.startswith('#'): continue 
							if len(ls) < 7: continue
							if ls[2] != 'CDS': continue
							
							scaffold = ls[0]
							start = int(ls[3])
							end = int(ls[4])
							direction = ls[6]

							old_lt = ls[8].split('ID=')[1].split(';')[0]
							final_lt = old_lt
							if rename_locus_tags:
								if (ci+1) < 10:
									pid = '00000'+str(ci+1)
								elif (ci+1) < 100:
									pid = '0000'+str(ci+1)
								elif (ci+1) < 1000:
									pid = '000'+str(ci+1)
								elif (ci+1) < 10000:
									pid = '00'+str(ci+1)
								elif (ci+1) < 100000:
									pid = '0'+str(ci+1)
								else:
									pid = str(ci+1)
								new_lt = lt_str + '_' + pid
								sample_old_to_new_lts[sample][old_lt] = [new_lt, scaffold,  str(start), str(end), direction]
								final_lt = new_lt
							ci += 1
							prot_score = '1'
							if (scaffold_lengths[sample][scaffold]-end) < 1000 or start < 1000:
								prot_score = '0'							
							prot_id_counts[final_lt] += 1
							bed_outfile_handle.write('\t'.join([str(x) for x in [scaffold, start, end, final_lt, prot_score, direction]]) + '\n')
					bed_outfile_handle.close()
					sample_beds[sample] = bed_file
					gff_iter += 1

		for pi in prot_id_counts:
			try:
				assert(prot_id_counts[pi] == 1)
			except:
				msg = 'Not all protein locus tags across genomes are unique! Please try running bofasa_prep again with the --rename-locus-tags option. Exiting now ...'
				sys.stderr.write(msg + '\n')
				logObject.error(msg)
				sys.exit(1)

		for subdir, dirs, files in os.walk(input_prokka_dir):
			for file in files:
				filepath = subdir + os.sep + file
				if filepath.endswith(".faa"):
					sample = '.faa'.join(file.split('/')[-1].split('.faa')[:-1])
					updated_faa = faa_dir + sample + '.faa'
					updated_faa_handle = open(updated_faa, 'w')
					sample_proteomes[sample] = updated_faa
					with open(filepath) as ofp:
						for rec in SeqIO.parse(ofp, 'fasta'):
							old_lt = rec.id
							final_lt = old_lt
							if rename_locus_tags:
								final_lt = ' '.join(sample_old_to_new_lts[sample][old_lt])
							updated_faa_handle.write('>' + final_lt + '\n' + str(rec.seq) + '\n')
					updated_faa_handle.close()

	elif input_type == 'Bakta directories':
		scaffold_lengths = defaultdict(dict)
		for subdir, dirs, files in os.walk(input_bakta_dir):
			for file in files:
				filepath = subdir + '/' + file
				if filepath.endswith('.fna'):
					sample = '.fna'.join(file.split('/')[-1].split('.fna')[:-1])
					sample_wgs[sample] = filepath
					with open(filepath) as ogf:
						for rec in SeqIO.parse(ogf, 'fasta'):
							scaffold = rec.id
							scaffold_lengths[sample][scaffold] = len(str(rec.seq))

		possible_locustags = util.createLocusTagOptions(3)
		gff_iter = 0 	
		prot_id_counts = defaultdict(int)
		sample_old_to_new_lts = defaultdict(dict)
		for subdir, dirs, files in os.walk(input_bakta_dir):
			for file in files:
				filepath = subdir + '/' + file
				if filepath.endswith(".gff3"):
					lt_str = possible_locustags[gff_iter]
					sample = '.gff3'.join(file.split('/')[-1].split('.gff3')[:-1])
					bed_file = bed_dir + sample + '.bed'
					bed_outfile_handle = open(bed_file, 'w')
					ci = 1
					with open(filepath) as ofp:
						for line in ofp:
							line = line.strip()
							ls = line.split('\t')

							if line.startswith('#'): continue 
							if len(ls) < 7: continue
							if ls[2] != 'CDS': continue
							
							scaffold = ls[0]
							start = int(ls[3])
							end = int(ls[4])
							direction = ls[6]

							old_lt = ls[8].split('ID=')[1].split(';')[0]
							final_lt = old_lt
							if rename_locus_tags:
								if (ci+1) < 10:
									pid = '00000'+str(ci+1)
								elif (ci+1) < 100:
									pid = '0000'+str(ci+1)
								elif (ci+1) < 1000:
									pid = '000'+str(ci+1)
								elif (ci+1) < 10000:
									pid = '00'+str(ci+1)
								elif (ci+1) < 100000:
									pid = '0'+str(ci+1)
								else:
									pid = str(ci+1)
								new_lt = lt_str + '_' + pid
								sample_old_to_new_lts[sample][old_lt] = [new_lt, scaffold, str(start), str(end), direction]
								final_lt = new_lt
							ci += 1
							prot_score = '1'
							if (scaffold_lengths[sample][scaffold]-end) < 1000 or start < 1000:
								prot_score = '0'	
							prot_id_counts[final_lt]						
							bed_outfile_handle.write('\t'.join([str(x) for x in [scaffold, start, end, final_lt, prot_score, direction]]) + '\n')
					bed_outfile_handle.close()
					sample_beds[sample] = bed_file
					gff_iter += 1

		
		for pi in prot_id_counts:
			try:
				assert(prot_id_counts[pi] == 1)
			except:
				msg = 'Not all protein locus tags across genomes are unique! Please try running bofasa_prep again with the --rename-locus-tags option. Exiting now ...'
				sys.stderr.write(msg + '\n')
				logObject.error(msg)
				sys.exit(1)

		for subdir, dirs, files in os.walk(input_bakta_dir):
			for file in files:
				filepath = subdir + os.sep + file
				if filepath.endswith(".faa") and not filepath.endswith(".hypotheticals.faa"):
					sample = '.faa'.join(file.split('/')[-1].split('.faa')[:-1])
					updated_faa = faa_dir + sample + '.faa'
					updated_faa_handle = open(updated_faa, 'w')
					sample_proteomes[sample] = updated_faa
					with open(filepath) as ofp:
						for rec in SeqIO.parse(ofp, 'fasta'):
							old_lt = rec.id
							final_lt = old_lt
							if rename_locus_tags:
								final_lt = ' '.join(sample_old_to_new_lts[sample][old_lt])
							updated_faa_handle.write('>' + final_lt + '\n' + str(rec.seq) + '\n')
					updated_faa_handle.close()


	# Step 2a: Running geNomad
	if run_genomad == True:	
		msg = '--------------------\nStep 2a\n--------------------\nRunning geNomad for phage and plasmid identification.'
		sys.stdout.write(msg + '\n')
		logObject.info(msg)

		genomad_dir = outdir + 'geNomad_Annotations/'
		util.setupReadyDirectory([genomad_dir])

		phage_protein_listing_file = outdir + 'Sample_Phage_Proteins.txt'
		plasmid_protein_listing_file = outdir + 'Sample_Plasmid_Proteins.txt' 
		util.determinePhagesAndPlasmids(sample_wgs, sample_beds, genomad_dir, phage_protein_listing_file, plasmid_protein_listing_file, logObject, threads=threads)

	# Step 2b: Annotate proteins with ISfinder databases
	msg = '--------------------\nStep 2b\n--------------------\nAnnotating IS elements using the ISFinder database.'
	sys.stdout.write(msg + '\n')
	logObject.info(msg)

	annot_dir = outdir + 'ISFinder_Annotations/'
	util.setupReadyDirectory([annot_dir])

	isfinder_protein_listing_file = outdir + 'Sample_IS_Element_Proteins.txt'
	util.annotateIsFinder(sample_proteomes, annot_dir, isfinder_protein_listing_file, logObject, threads=threads)

	# Step 3: Annotate proteins with Pfam and split into domain/inter-domain "chunks" or units
	msg = '--------------------\nStep 3\n--------------------\nAnnotating proteins with Pfam HMMs to split them into domain/inter-domain "chunks" or units.'
	sys.stdout.write(msg + '\n')
	logObject.info(msg)

	split_proteins_dir = outdir + 'Domain_and_Interdomain_FASTAs/'
	domain_coord_info_file = outdir + 'Sample_Domain_and_InterDomain_Information.txt'
	util.setupReadyDirectory([split_proteins_dir])
	sample_ccds_proteomes = util.annotateAndSplitProteinsUsingPfam(sample_proteomes, split_proteins_dir, domain_coord_info_file, logObject, minimal_length=min_length, threads=threads)

	# Step 4: Finalize setting up for final bofasa analysis 
	msg = '--------------------\nStep 4\n--------------------\nNearly there, putting together final files.'
	sys.stdout.write(msg + '\n')
	logObject.info(msg)

	genome_info_listing_file = outdir + 'Info_on_Input_Genome_Files.txt'	
	genome_info_listing_handle = open(genome_info_listing_file, 'w')
	header = ['sample', 'ccds_faa', 'proteome', 'bed_coord', 'genome']
	genome_info_listing_handle.write('\t'.join(header) + '\n')
	for sample in sample_wgs:
		fna = sample_wgs[sample]
		faa = sample_proteomes[sample]
		ccds_faa = sample_ccds_proteomes[sample]
		bed = sample_beds[sample]
		sample_info = [str(x) for x in [sample, ccds_faa, faa, bed, fna]]
		genome_info_listing_handle.write('\t'.join(sample_info) + '\n')
	genome_info_listing_handle.close()

	# Close logging object and exit
	util.closeLoggerObject(logObject)
	sys.exit(0)

if __name__ == '__main__':
	prepare_input()
