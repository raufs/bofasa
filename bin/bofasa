import os
import shutil
import sys
import argparse
from Bio import SeqIO
from bofasa import util
import subprocess
import multiprocessing
import shutil
from rich_argparse import RawTextRichHelpFormatter

def create_parser():
	""" Parse arguments """
	parser = argparse.ArgumentParser(description="""

	██████╗  ██████╗ ███████╗ █████╗ ███████╗ █████╗ 
	██╔══██╗██╔═══██╗██╔════╝██╔══██╗██╔════╝██╔══██╗
	██████╔╝██║   ██║█████╗  ███████║███████╗███████║
	██╔══██╗██║   ██║██╔══╝  ██╔══██║╚════██║██╔══██║
	██████╔╝╚██████╔╝██║     ██║  ██║███████║██║  ██║
	╚═════╝  ╚═════╝ ╚═╝     ╚═╝  ╚═╝╚══════╝╚═╝  ╚═╝

	Program: bofasa
	Authors: Rauf Salamzade, Aamuktha Kottapalli, Lindsay R. Kalan 
	Affiliation: University of Wisconsin - Madsion, McMaster University								  
								  
	bacterial ortholog finding and syntenic analysis (bofasa)
	
	bofasa aims to prioritize accuracy over speed and is thus intended 
	for investigations with fewer than 200 genomes. bofasa is also
	specifically designed for multi-species analyses. Check out 
	the documentation for more information on usage, arguments, and 
	results generated: 
								
	""", formatter_class=RawTextRichHelpFormatter)

	parser.add_argument('-i', '--bofasa-prep-dir', help='Input - a directory produced by bofasa-prep.', required=True)
	parser.add_argument('-o', '--output-dir', help='Output directory.', required=True)
	parser.add_argument('-sr', '--surrounding-bp', type=int, help="The number of basepairs to look up and downstream\nfor syntenic analysis [Default is 10000].", required=False, default=10000)
	parser.add_argument('-ogc', '--og-consensus', action='store_true', help="Determine consensus sequences of ortholog groups\nfor annotation of new genomes.", required=False, default=False)
	parser.add_argument('-cg', '--core-genome', action='store_true', help="Construct core genome alignment(s) using (near)\nsingle-copy-core resolved domain ortholog groups\nfor phylogenomics.", required=False, default=False)
	parser.add_argument('-dj', '--dog-jaccard', type=float, help="The Jaccard index threshold for domain ortholog\ngroup overlap between two pairs of proteins\nneeded to consider them as sharing an edge. Will be\nautomatically lowered for cases where single-copy\ndomain ortholog groups are observed [Default\nis 0.25].", required=False, default=0.25)
	parser.add_argument('-fic', '--fixation-index-cutoff', type=float, help="Fixation index cutoff for domain ortholog\ngroup re-merging following phylogenetic splitting\n[Default is 0.25].", required=False, default=0.25)
	parser.add_argument('-smb', '--skip-merge-back', action='store_true', help="Skip fixation index-based assessment for\ndeciding whether to perform re-joining of split ortholog\npartitions.", required=False, default=False)
	parser.add_argument('-spr', '--skip-phylo-refine', action='store_true', help="Skip phylogenetic refinement of domain ortholog\ngroups.", required=False, default=False)
	parser.add_argument('-rs', '--rooting-seeds', type=int, help="The maximum number of nodes to try for rooting.\nA random sampling is performed [Default is\n1; uses midpoint rooting].", required=False, default=1)
	parser.add_argument('-qa', '--quality-alignments', action='store_true', help="Prioritize quality over speed for constructing\ndomain-resolution ortholog group protein alignments.\nUses MUSCLE align mode instead of super5 mode.", required=False, default=False)
	parser.add_argument('-us', '--ultra-sens', action='store_true', help="Use ultra-sensitivity parameters for running\nOrthoFinder DIAMOND searches.", required=False, default=False)
	parser.add_argument('-mi', '--mcl-inflation', type=float, help="MCL inflation parameter for determining coarse\ndomain-resolution ortholog groups via OrthoFinder\n[Default is 1.2].", required=False, default=1.2)
	parser.add_argument('-ns', '--near-scc-prop', type=float, help="Proportion of genomes which single-copy resolved\ndomain ortholog groups need to be found in for\nconstructing core genome alignment for\nphylogenomics [Default is 0.80].", required=False, default=0.95)
	parser.add_argument('-c', '--threads', type=int, help="Total number of cores/threads to use [Default is 4].", required=False, default=4)
	parser.add_argument('-mrd', '--max-recursion-depth', type=int, help="The maximum recursion depth.", required=False, default=5000)	
	parser.add_argument('-mm', '--max-memory', type=int, help='Uses resource module to set soft memory limit. Provide\nin Giga-bytes [Default is 32].', default=32, required=False)
	parser.add_argument('-v', '--version', action='store_true', help="Get version and exit.", required=False, default=False)
	
	args = parser.parse_args()
	return args

def bofasa():
	"""
	Void function which runs primary workflow for program.
	"""

	# get version
	version = util.getVersion()

	if len(sys.argv)>1 and ('-v' in set(sys.argv) or '--version' in set(sys.argv)):
		sys.stdout.write(version + '\n')
		sys.exit(0)

	"""
	PARSE ARGUMENTS
	"""
	myargs = create_parser()

	bofasa_prep_dir = os.path.abspath(myargs.bofasa_prep_dir) + '/'
	outdir = os.path.abspath(myargs.output_dir) + '/'
	mcl_inflation = myargs.mcl_inflation
	surrounding_bp = myargs.surrounding_bp
	threads = myargs.threads
	max_memory = myargs.max_memory
	dog_jaccard = myargs.dog_jaccard
	fixation_index_cutoff = myargs.fixation_index_cutoff
	og_consensus_flag = myargs.og_consensus
	core_genome_flag = myargs.core_genome
	skip_merge_back_flag = myargs.skip_merge_back
	skip_phylo_refine_flag = myargs.skip_phylo_refine
	quality_alignment_flag = myargs.quality_alignments
	rooting_seeds_count = myargs.rooting_seeds
	near_scc_prop = myargs.near_scc_prop
	ultra_sens_flag = myargs.ultra_sens
	max_recursion_depth = myargs.max_recursion_depth

	sys.setrecursionlimit(max_recursion_depth)

	if os.path.isdir(outdir):
		sys.stderr.write("Output directory exists! Overwriting in 5 seconds, but only where needed.\n ")
	else:
		os.system('mkdir %s' % outdir)
	
	"""
	START WORKFLOW
	"""

	#if skip_phylo_refine_flag and core_genome_flag:
	#	msg = 'Error: unable to specify both --skip-phylo-refine and --core-genome. Exiting ...'
	#	sys.stderr.write(msg + '\n')
	#	sys.exit(1)

	checkdir = outdir + 'Checkpoint_Files/'
	if not os.path.isdir(checkdir):
		util.setupReadyDirectory([checkdir])
	
	findir = outdir + 'Final_Results/'
	if not os.path.isdir(findir):
		util.setupReadyDirectory([findir])

	sys.stdout.write('Input command:\n%s\n' % ' '.join(sys.argv))

	# create logging object
	log_file = outdir + 'Progress.log'
	logObject = util.createLoggerObject(log_file)
	logObject.info("Saving parameters for future records.")
	parameters_file = outdir + 'Parameter_Inputs.txt'
	parameter_values = [bofasa_prep_dir, outdir, surrounding_bp, mcl_inflation, ultra_sens_flag, 
					   fixation_index_cutoff, dog_jaccard, skip_phylo_refine_flag, rooting_seeds_count,
					   skip_merge_back_flag, quality_alignment_flag, og_consensus_flag, 
					   core_genome_flag, near_scc_prop, threads, max_memory]
	parameter_names = ["bofasa_prep directory", "Output directory", "Surrounding BP for syntenic conservation assessment",
					   "MCL inflation", "Use ultra-sensitivity mode for DIAMOND searching in OrthoFinder?",
					   "Fixation index cutoff for domain ortholog group re-merging following phylogenetic splitting", 
					   "Jaccard index cutoff for domain ortholog groups shared between full protein pairs",
					   "Skip phylogenetic refinement of domain ortholog groups?", "Maximum number of nodes to try for rooting",
					   "Skip fixation index-based re-mergining of split ortholog partitions?", 
					   "High-quality alignment method?", "Determine consensus sequences for ortholog groups?", 
					   "Create core genome alignment(s) for phylogenomics?", "Near-SCC conservation proportion?",
					   "Number of threads/cores", "Maximum memory in GB"]
	# "Exhaustive assessment of ties for phylogeny resolution of domain ortholog groups?",

	util.logParametersToFile(parameters_file, parameter_names, parameter_values)
	logObject.info("Done saving parameters!")

	logObject.info('Running bofasa version %s' % version)
	sys.stdout.write('Running bofasa version %s\n' % version)

	# set max memory limit
	if max_memory != None:
		logObject.info("Setting maximum memory usage to: %dGB" % max_memory)
		try:
			util.memory_limit(max_memory)
		except Exception as e:
			logObject.info("Error setting memory limit")
			sys.stdout.write("Error setting memory limit\n")

	index_file = bofasa_prep_dir + 'Info_on_Input_Genome_Files.txt'
	isfinder_file = bofasa_prep_dir + 'Sample_IS_Element_Proteins.txt'
	phage_file = bofasa_prep_dir + 'Sample_Phage_Proteins.txt'
	plasmid_file = bofasa_prep_dir + 'Sample_Plasmid_Proteins.txt'
	try:
		assert(os.path.isdir(bofasa_prep_dir))
		assert(os.path.isfile(index_file) and os.path.isfile(isfinder_file))
		msg = 'geNomad was not run ...'
		if os.path.isfile(phage_file) and os.path.isfile(plasmid_file):
			msg = 'geNomad was successfully run on input genomes and will be used downstream ...'
		sys.stdout.write(msg + '\n')
		logObject.info(msg)
	except:
		sys.stderr.write('Issue with validating directory with input genomes exists.\n')
		sys.exit(1)

	# Step 1: Run OrthoFinder
	step1_checkpoint_file = checkdir + 'Step1.txt'
	msg = '--------------------\nStep 1\n--------------------\nRunning OrthoFinder.'
	sys.stdout.write(msg + '\n')
	logObject.info(msg)
	orthofinder_input_dir = bofasa_prep_dir + 'Domain_and_Interdomain_FASTAs/'
	orthofinder_results_dir = outdir + 'OrthoFinder_Results/'
	
	if not os.path.isfile(step1_checkpoint_file):
		orthofinder_cmd = ['orthofinder', '-f', orthofinder_input_dir, '-o', orthofinder_results_dir, '-t', str(threads), '-og', '-I', str(mcl_inflation)]
		if ultra_sens_flag:
			orthofinder_cmd += ['-S', 'diamond_ultra_sens']
		try:
			os.system(' '.join(orthofinder_cmd))
			logObject.info('Successfully ran: %s' % ' '.join(orthofinder_cmd))
		except Exception as e:
			logObject.error('Had an issue running: %s' % ' '.join(orthofinder_cmd))
			sys.stderr.write('Had an issue running: %s' % ' '.join(orthofinder_cmd))
			logObject.error(e)
			sys.exit(1)
		os.system('echo "DONE" > %s' % step1_checkpoint_file)

	orthofinder_tsv_file = orthofinder_results_dir + [sd for sd in os.listdir(orthofinder_results_dir)][0] + '/Orthogroups/Orthogroups.tsv'
	orthofinder_tsv_singletons_file = orthofinder_results_dir + [sd for sd in os.listdir(orthofinder_results_dir)][0] + '/Orthogroups/Orthogroups_UnassignedGenes.tsv'
	orthofinder_graph_file = orthofinder_results_dir + [sd for sd in os.listdir(orthofinder_results_dir)][0] + '/WorkingDirectory/OrthoFinder_graph.txt'
	orthofinder_seqid_file = orthofinder_results_dir + [sd for sd in os.listdir(orthofinder_results_dir)][0] + '/WorkingDirectory/SequenceIDs.txt'
	orthofinder_fasta_dir = orthofinder_results_dir + [sd for sd in os.listdir(orthofinder_results_dir)][0] + '/Orthogroup_Sequences/'
	try:
		assert(os.path.isfile(orthofinder_tsv_file) and os.path.isfile(orthofinder_tsv_singletons_file) and os.path.isfile(orthofinder_graph_file) and os.path.isfile(orthofinder_seqid_file))
	except:
		logObject.error('Could not validate OrthoFinder results exist. Perhaps investigate the OrthoFinder log files for further logging information.')
		sys.stderr.write('Could not validate Orthofinder results exist. Perhaps investigate the OrthoFinder log files for further logging information.\n')

	# Step 2: Process OrthoFinder results and determine more resolved domain ortholog groups
	step2_checkpoint_file = checkdir + 'Step2.txt'
	msg = '--------------------\nStep 2\n--------------------\nDetermine refined domain-resolution ortholog groups.'
	sys.stdout.write(msg + '\n')
	logObject.info(msg)
	resdog_dir = outdir + 'Resolved_Domain_Ortholog_Groups/'
	resulting_dogs_file = findir + 'Domain_Ortholog_Groups.tsv'
	if not os.path.isfile(step2_checkpoint_file):
		if skip_phylo_refine_flag:
			util.combineOrthoFinderResults(orthofinder_tsv_file, orthofinder_tsv_singletons_file, resulting_dogs_file, logObject)
		else:
			util.setupReadyDirectory([resdog_dir])
			util.resolveOrthogroupsUsingPhylogenetics(orthofinder_fasta_dir, orthofinder_tsv_file, orthofinder_tsv_singletons_file, 
												resdog_dir, resulting_dogs_file, logObject, use_super5=(not quality_alignment_flag), 
												skip_merge_back_flag=skip_merge_back_flag, rooting_seeds=rooting_seeds_count,
												fixation_index_cutoff=fixation_index_cutoff, threads=threads)
		os.system('echo "DONE" > %s' % step2_checkpoint_file)

	# Step 3: Determine protein-resolution ortholog groups from domain-resolution ortholog groups
	step3_checkpoint_file = checkdir + 'Step3.txt'
	msg = '--------------------\nStep 3\n--------------------\nDetermine protein-resolution ortholog groups.'
	sys.stdout.write(msg + '\n')
	logObject.info(msg)
	protein_cluster_dir = outdir + 'Protein_Clustering/'
	resulting_ogs_file = findir + 'Protein_Ortholog_Groups.tsv'
	if not os.path.isfile(step3_checkpoint_file):
		util.setupReadyDirectory([protein_cluster_dir])
		util.determineProteinOrthogroup(resulting_dogs_file, protein_cluster_dir, resulting_ogs_file, logObject, dj=dog_jaccard, threads=threads)
		os.system('echo "DONE" > %s' % step3_checkpoint_file)

	# Step 4: Determine surrounding contexts for each ortholog group
	step4_checkpoint_file = checkdir + 'Step4.txt'
	msg = '--------------------\nStep 4\n--------------------\nAssessing neighborhoods for each ortholog group.'
	sys.stdout.write(msg + '\n')
	logObject.info(msg)
	surround_info_dir = outdir + 'Surrounding_Context_Information/'
	og_context_info_file = surround_info_dir + 'Coarse_OrthoGroup_Contexts.tsv'
	if not os.path.isfile(step4_checkpoint_file):
		util.setupReadyDirectory([surround_info_dir])
		util.determineOrthologGroupContexts(bofasa_prep_dir, og_context_info_file, surround_info_dir, resulting_ogs_file, logObject, surrounding_bp=surrounding_bp, threads=threads)
		os.system('echo "DONE" > %s' % step4_checkpoint_file)

	# Step 5: Create final summarizations
	step5_checkpoint_file = checkdir + 'Step5.txt'
	msg = '--------------------\nStep 5\n--------------------\nCreating final consolidated report.'
	sys.stdout.write(msg + '\n')
	logObject.info(msg)
	final_result_file = findir + 'Orthogroup_Overview.xlsx'
	if not os.path.isfile(step5_checkpoint_file):
		util.createFinalReport(bofasa_prep_dir, og_context_info_file, final_result_file, logObject)
		os.system('echo "DONE" > %s' % step5_checkpoint_file)

	# Step 6: Create final visuals
	step6_checkpoint_file = checkdir + 'Step6.txt'
	msg = '--------------------\nStep 6\n--------------------\nCreating final summary visualization of conservation vs. neighborhood syntenic conservation.'
	sys.stdout.write(msg + '\n')
	logObject.info(msg)
	tmp_result_file = surround_info_dir + 'Simplified_Info_for_Plotting.tsv'
	final_result_plot = findir + 'Orthogroup_Conservation_vs_ContextEntropy.html'
	if not os.path.isfile(step6_checkpoint_file):
		util.createFinalVisual(bofasa_prep_dir, tmp_result_file, og_context_info_file, final_result_plot, logObject)
		os.system('echo "DONE" > %s' % step6_checkpoint_file)

	if og_consensus_flag:
		# Step 7: (Optional) Create profile-HMM database
		step7_checkpoint_file = checkdir + 'Step7.txt'
		msg = '--------------------\nStep 7\n--------------------\nConstructing ortholog group profile HMMs and consensus sequences.'
		sys.stdout.write(msg + '\n')
		logObject.info(msg)
		og_seqs_dir = outdir + 'Ortholog_Group_Sequences/'
		og_algn_dir = outdir + 'Ortholog_Group_Alignments/'
		og_hmms_dir = outdir + 'Ortholog_Group_HMMs/'
		og_cons_dir = outdir + 'Ortholog_Group_Consensus_Sequences/'
		concatenated_consensus_seqs_file = findir + 'Orthogroup_Consensus_Sequences.faa'
		if not os.path.isfile(step7_checkpoint_file):
			util.setupReadyDirectory([og_seqs_dir, og_algn_dir, og_hmms_dir, og_cons_dir])
			util.createProteinAlignments(bofasa_prep_dir, resulting_ogs_file, og_seqs_dir, og_algn_dir, 
								         logObject, use_super5=not(quality_alignment_flag), threads=threads)
			util.createProfileHMMsAndConsensusSeqs(og_algn_dir, og_hmms_dir, og_cons_dir, logObject, threads=threads)
			util.concatenateConsensusAlignment(og_cons_dir, concatenated_consensus_seqs_file, logObject)
			os.system('echo "DONE" > %s' % step7_checkpoint_file)

	if core_genome_flag:
		# Step 8: (Optional) Create core genome alignment
		step8_checkpoint_file = checkdir + 'Step8.txt'
		msg = '--------------------\nStep 8\n--------------------\nCreating core genome alignment from (near) single-copy-core domain ortholog groups.'
		sys.stdout.write(msg + '\n')
		logObject.info(msg)
		rdog_seqs_dir = outdir + 'NearSCC_Resolved_Domain_Ortholog_Group_Sequences/'
		rdog_algn_dir = outdir + 'NearSCC_Resolved_Domain_Ortholog_Group_Alignments/'
		rdog_trim_dir = findir + 'NearSCC_Resolved_Domain_Ortholog_Group_Trimmed_Alignments/'
		merged_core_genome_file = findir + 'Core_Genome_Alignment.faa'
		if not os.path.isfile(step8_checkpoint_file):
			util.setupReadyDirectory([rdog_seqs_dir, rdog_algn_dir, rdog_trim_dir])
			util.createNearSCCResolvedDomainProteinAlignments(bofasa_prep_dir, resulting_dogs_file, rdog_seqs_dir, 
													          rdog_algn_dir, rdog_trim_dir, merged_core_genome_file, 
															  logObject, use_super5=not(quality_alignment_flag), 
															  near_scc_prop=near_scc_prop, threads=threads)
			os.system('echo "DONE" > %s' % step8_checkpoint_file)

	# Close logging object and exit
	util.closeLoggerObject(logObject)
	sys.exit(0)

if __name__ == '__main__':
	bofasa()
