import os
import shutil
import sys
import argparse
from Bio import SeqIO
from bofasa import util
import subprocess
import multiprocessing
import shutil

def create_parser():
	""" Parse arguments """
	parser = argparse.ArgumentParser(description="""
	Program: bofasa
								  
	bacterial ortholog finding and syntenic analysis (bofasa)
	
    bofasa aims to prioritize accuracy over speed and is thus intended for investigations with
	fewer than <100 genomes. bofasa is specifically designed for multi-species analyses, if 
	working with a single species, we recommend checking out some other alternatives, e.g.
	Panaroo - which offers a boost in accuracy and speed through use of syntenic conservation.
								  						  							  
	bofasa determines coarse ortholog groups using OrthoFinder (Emms and Kelly 2016; 
    Emms and Kelly 2019). Importantly, domain resolution proteome input files can be prepared 
	by prepare_input as an option and the inflation parameter for MCL in OrthoFinder is decreased
	to produce larger (but fewer) clusters of ortholog groups. If requested, bofasa then constructs 
	gene trees for all ortholog groups and attempts to parse unrooted trees using all nodes and leafs 
	as rooting sources to optimally resolve more fine-grain ortholog groups. Finally, bofasa performs 
	syntenic analysis to compute a score quantifying the level of conservation for each ortholog 
	group and annotates genes and domains using PGAP/KOfam HMMs and Pfam HMMs, respectively.
								  
	bofasa aims to prioritize accuracy over speed and is thus intended for investigations with
	fewer than <100 genomes. 
	""", formatter_class=argparse.RawTextHelpFormatter)

	parser.add_argument('-i', '--prepare_input_dir', help='Directory produced by prepare_input.', required=False, default=None)
	parser.add_argument('-o', '--output_dir', help='Output directory path.', required=True)
	parser.add_argument('-c', '--cpus', type=int, help="Total number of cpus/threads to use for running OrthoFinder2/prodigal.\n[Default is 1].", required=False, default=1)
	#parser.add_argument('-fr', '--fine_resolution_orthology', help="Perform fine resolution orthology inference [Default is False].", required=False, default=False)
	parser.add_argument('-a', '--annotate', help="Create consensus sequences of ortholog groups and annotate.")
	parser.add_argument('-sr', '--surrounding_bp', help="The number of basepairs to look up and downstream for syntenic analysis [Default is 10000].", required=False, default=10000)
	parser.add_argument('-mm', '--max_memory', type=int, help='Uses resource module to set soft memory limit. Provide in Giga-bytes.\nGenerally memory shouldn\'t be a major concern unless working\nwith hundreds of large metagenomes. [currently\nexperimental; default is None].', default=None, required=False)
	parser.add_argument('-v', '--version', action='store_true', help="Get version and exit.", required=False, default=False)

	args = parser.parse_args()
	return args

def bofasa():
	"""
	Void function which runs primary workflow for program.
	"""

	# get version
	version = util.getVersion()

	if len(sys.argv)>1 and ('-v' in set(sys.argv) or '--version' in set(sys.argv)):
		sys.stdout.write(version + '\n')
		sys.exit(0)

	"""
	PARSE ARGUMENTS
	"""
	myargs = create_parser()

	prepare_input_dir = os.path.abspath(myargs.prepare_input_dir) + '/'
	outdir = os.path.abspath(myargs.output_dir) + '/'
	surrounding_bp = myargs.surrounding_bp
	cpus = myargs.cpus
	max_memory = myargs.max_memory

	if os.path.isdir(outdir):
		sys.stderr.write("Output directory exists! Exiting\n ")
		sys.exit(1)
	else:
		os.system('mkdir %s' % outdir)

	if prepare_input_dir != None: 
		try:
			assert(os.path.isdir(prepare_input_dir))
			prepare_input_dir = os.path.abspath(prepare_input_dir) + '/'
		except:
			sys.stderr.write('Issue with validating directory with input genomes exists.\n')
			sys.exit(1)

	"""
	START WORKFLOW
	"""

	sys.stdout.write('Input command:\n%s\n' % ' '.join(sys.argv))

	# create logging object
	log_file = outdir + 'Progress.log'
	logObject = util.createLoggerObject(log_file)
	logObject.info("Saving parameters for future records.")
	parameters_file = outdir + 'Parameter_Inputs.txt'
	parameter_values = [prepare_input_dir, outdir, surrounding_bp, cpus, max_memory]
	parameter_names = ["prepare_input Directory", "Output Directory", "Surrounding BP", 
					   "Number of CPUs", "Maximum Memory in GB"]
	util.logParametersToFile(parameters_file, parameter_names, parameter_values)
	logObject.info("Done saving parameters!")

	logObject.info('Running bofasa version %s' % version)
	sys.stdout.write('Running bofasa version %s\n' % version)

	# set max memory limit
	if max_memory != None:
		logObject.info("Setting maximum memory usage to: %dGB" % max_memory)
		try:
			util.memory_limit(max_memory)
		except Exception as e:
			logObject.info("Error setting memory limit")
			sys.stdout.write("Error setting memory limit\n")

	# Step 1: Run OrthoFinder
	sys.stdout.write('--------------------\nStep 1\n--------------------\nRunning OrthoFinder.\n')
	orthofinder_input_dir = prepare_input_dir + 'Formatted_Proteomes/'
	orthofinder_results_dir = outdir + 'OrthoFinder_Results/'
	orthofinder_cmd = ['orthofinder', '-f', orthofinder_input_dir, '-o', orthofinder_results_dir, '-t', str(cpus), '-og']
	try:
		subprocess.call(' '.join(orthofinder_cmd), shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
						executable='/bin/bash')
		logObject.info('Successfully ran: %s' % ' '.join(orthofinder_cmd))
	except Exception as e:
		logObject.error('Had an issue running: %s' % ' '.join(orthofinder_cmd))
		sys.stderr.write('Had an issue running: %s' % ' '.join(orthofinder_cmd))
		logObject.error(e)
		sys.exit(1)

	# Close logging object and exit
	util.closeLoggerObject(logObject)
	sys.exit(0)

if __name__ == '__main__':
	bofasa()